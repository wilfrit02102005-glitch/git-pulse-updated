# =========================================================
# GitPulse - GitHub Team Intelligence Platform
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to version control.
# =========================================================

# --- Flask -------------------------------------------------
# Secret key used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1
# Public base URL of the app. Needed for OAuth redirects.
BASE_URL=http://localhost:5000

# --- GitHub OAuth App --------------------------------------
# Create one at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Must match the "Authorization callback URL" registered in GitHub.
GITHUB_REDIRECT_URI=http://localhost:5000/auth/callback

# --- Access Control ----------------------------------------
# Comma separated list of GitHub usernames allowed to log in.
# Example: ALLOWED_GITHUB_USERS=alice,bob,charlie
# Leave empty to allow everyone (NOT recommended in production).
ALLOWED_GITHUB_USERS=

# --- GitHub data scope (optional) ----------------------------
# Used only as a bootstrap default when a user has not picked a
# repository from the dashboard selector. After login, each user
# selects any repository they can access - these are not required.
# Owner of the repository you want to analyze.
# A GitHub username OR an organization name. Example: GITHUB_OWNER=acme-corp
GITHUB_OWNER=
# Name of the primary repository to analyze. Example: GITHUB_REPO=main-app
GITHUB_REPO=

# --- GitHub API token (server-side fallback) ---------------
# The app uses this token to build the dashboard report when the user has
# not logged in. Create one at https://github.com/settings/tokens
#  - Classic PAT: needs the "repo" scope (or "public_repo" for public repos).
#  - Fine-grained PAT: needs read access to the target repository.
# NEVER share this token. It is only checked for presence, never logged.
GITHUB_TOKEN=

# --- AI provider (optional) --------------------------------
# GitPulse uses Anthropic Claude for AI analysis. ANTHROPIC_API_KEY wins over
# AI_API_KEY when both are set; AI_MODEL is an alias for ANTHROPIC_MODEL.
# If no key is configured, GitPulse falls back to rule-based AI suggestions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Generic aliases (alternative names for the same settings):
AI_API_KEY=
AI_MODEL=

# --- Team & webhook config ----------------------------------
# Comma-separated list of GitHub usernames to track as "the team".
# If empty, GitPulse falls back to the repository's contributors.
# Example: GITHUB_TEAM=alice,bob,charlie
GITHUB_TEAM=
# GitHub webhook secret. Register the webhook at
# https://github.com/<owner>/<repo>/settings/hooks pointing at
# <BASE_URL>/webhook. Used to verify X-Hub-Signature-256.
# Leave empty only for local development.
GITHUB_WEBHOOK_SECRET=

# --- Activity scoring ---------------------------------------
# Window (days) over which team activity is scored.
ACTIVITY_WINDOW_DAYS=30
# Days since last activity to be considered "recently active".
RECENTLY_ACTIVE_DAYS=7
# Days since last activity to be considered "inactive".
INACTIVE_DAYS=30
# Weights for the activity score. They must sum to 100.
SCORE_WEIGHT_COMMITS=40
SCORE_WEIGHT_PRS=25
SCORE_WEIGHT_REVIEWS=20
SCORE_WEIGHT_ISSUES=15
# Score thresholds (0-100) for status labels.
THRESHOLD_HIGHLY_ACTIVE=80
THRESHOLD_ACTIVE=60
THRESHOLD_LOW=30

# --- AI auto-fix (safe workflow) ----------------------------
# If 1, GitPulse clones the repo locally and runs whitelisted
# test/lint commands before proposing an AI fix as a pull request.
# Never merged automatically, never touches the default branch.
AI_FIX_LOCAL_VALIDATION=0
# Command(s) run to validate a fix. Semicolon-separated.
AI_FIX_TEST_CMD=python -m pytest
AI_FIX_LINT_CMD=

# --- Storage ------------------------------------------------
# SQLite database path for AI analyses, fix attempts and webhook events.
GITPULSE_DB_PATH=data/gitpulse.db

# --- Logging ------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Rate limiting (security) -------------------------------
# Max login attempts before the app rate-limits an IP.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
